    "dev": "node scripts/build-starter-pk3.mjs && vite --host",
    "build": "node scripts/build-starter-pk3.mjs && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
