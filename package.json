{
  "name": "quake3-webgl2-arena",
  "version": "1.32.0",
  "private": true,
  "type": "module",
  "description": "100% Quake III Arena (1999) HTML5 / WebGL2 Engine with .PK3 VFS, .BSP v46, .MD3 v15 Tag-Rigging, Multipass Shaders, 125Hz Pmove Physics, QVM & OpenArena/nk-oa-assets",
  "scripts": {
    "assets:build": "node scripts/build-starter-pk3.mjs",
